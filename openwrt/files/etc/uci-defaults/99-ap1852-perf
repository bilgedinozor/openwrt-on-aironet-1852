#!/bin/sh
# AP1852 performance defaults (runs once on first boot after flashing).
# Measured on a 1000/50 line: ~285 Mbit/s with stock settings, ~930 Mbit/s
# with L2 scaling (DTS) + software flow offloading + packet steering through
# /usr/libexec/platform/packet-steering.sh. Only fills in unset values, so
# user changes survive upgrades.

[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "cisco,ap1852" ] || exit 0

if [ -z "$(uci -q get firewall.@defaults[0].flow_offloading)" ]; then
	uci set firewall.@defaults[0].flow_offloading=1
	uci commit firewall
fi

if [ -z "$(uci -q get network.globals.packet_steering)" ]; then
	uci set network.globals.packet_steering=1
	uci commit network
fi

exit 0
